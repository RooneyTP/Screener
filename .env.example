# Salin file ini menjadi .env lalu isi nilainya (JANGAN commit .env!).
# Cara aman mengisi: python isi_env.py  (input tersembunyi, tidak lewat chat).

# ── Wajib ──
INVEZGO_API_KEY=

# ── Telegram (OPSIONAL — kosong = dilewati; hasil tetap masuk RisetSaham) ──
