# Salin file ini menjadi .env lalu isi nilainya (JANGAN commit .env!).
# Cara aman mengisi: python isi_env.py  (input tersembunyi, tidak lewat chat).

# ── Sumber data (opsional) ──
# Kosongkan / biarkan → pakai data lokal RisetSaham (Yahoo + Stockbit server).
# Set "invezgo" kalau mau kembali ke SDK Invezgo (butuh INVEZGO_API_KEY).
# SCREENER_DATA=risetsaham

# ── Hanya bila SCREENER_DATA=invezgo ──
INVEZGO_API_KEY=

# ── Telegram (OPSIONAL — kosong = dilewati; hasil tetap masuk RisetSaham) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Opsional: narasi AI (DeepSeek/OpenCodeZen) ──
DEEPSEEK_API_KEY=

# ── Opsional: override token kirim ke RisetSaham ──
# (default dibaca otomatis dari /home/yuan/risetsaham/.env → SCREENER_TOKEN)
# SCREENER_TOKEN=
